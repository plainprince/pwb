.welcome {
    background-color: #1e1e2e;
    padding: 28px;
    gap: 16px;
}

.title {
    color: #89b4fa;
    font-size: 30px;
}

.subtitle {
    color: #cdd6f4;
    font-size: 17px;
}

.card {
    background-color: #313244;
    padding: 18px;
    gap: 10px;
    border-radius: 10px;
}

.card-title {
    color: #a6e3a1;
    font-size: 18px;
}

.card-hint {
    color: #bac2de;
    font-size: 14px;
}

.chips {
    flex-direction: row;
    gap: 8px;
    padding: 0;
    margin-top: 10px;
}

.chip {
    flex-direction: row;
    align-items: center;
    background-color: #45475a;
    padding: 5px;
    border-radius: 8px;
    font-size: 13px;
    color: #cdd6f4;
}

#ctx-btn {
    background-color: #fab387;
    color: #11111b;
    font-size: 15px;
    padding: 9px;
    border-radius: 6px;
    cursor: pointer;
}
