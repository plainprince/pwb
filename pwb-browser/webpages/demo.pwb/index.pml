<plain>
    <head>
        <title>Untrackable Plain Web Demo</title>
    </head>
    <view class="hero">
        <text class="heading">Welcome to the PlainWeb!</text>
        <text class="subtitle">Built with PML (Plain Markup), PSS (Plain Style), and JS.</text>
        <view class="icon-row">
            <icon-home id="ic-home"/>
            <icon-search/>
            <icon-star/>
            <icon-settings/>
            <icon-github/>
        </view>
        <input id="demo-input" placeholder="Type something… (press Enter)">
        <text id="echo-text" class="subtitle">Your input will echo here.</text>
        <button id="main-btn" title="Click to explore the network">Explore Network</button>
    </view>
</plain>