.hero {
    background-color: #1e1e2e;
    /* Viewport-relative sizing (Xpx → X/6 vh ≈ old scaled appearance): */
    padding: 5vh;
    gap: 2.5vh;
}

.heading {
    color: #89b4fa;
    font-size: 4.7vh;
    cursor: text;
}

.subtitle {
    color: #cdd6f4;
    font-size: 2.7vh;
    cursor: text;
}

.icon-row {
    flex-direction: row;
    gap: 2.5vh;
    padding: 0;
}

icon {
    color: #89b4fa;
    font-size: 4vh;
}

#ic-home {
    color: #a6e3a1;
}

#main-btn {
    background-color: #a6e3a1;
    color: #11111b;
    font-size: 2.5vh;
    padding: 2vh;
    border-radius: 8px;
    cursor: pointer;
}
